# SentinelForge Environment Configuration
# Copy this file to .env and fill in your values.
# Without API keys, the tool uses realistic mock threat intelligence data.

# ── Threat Intelligence API Keys (Optional) ────────────────────────────────
# VirusTotal - Get free key at: https://www.virustotal.com/gui/sign-in
VIRUSTOTAL_API_KEY=

# AlienVault OTX - Get free key at: https://otx.alienvault.com/
OTX_API_KEY=

# ── Application Settings ───────────────────────────────────────────────────
DEBUG=false

# HTTP timeout in seconds for scanner requests
HTTP_TIMEOUT=10.0

# Threat intel cache TTL in seconds (3600 = 1 hour)
INTEL_CACHE_TTL=3600

# ── Demo Target ────────────────────────────────────────────────────────────
# Default URL pre-filled in the scan form
DEMO_TARGET_URL=http://localhost:9000

# ── SOAR Webhook (Optional) ────────────────────────────────────────────────
# Slack/Teams/custom webhook URL for SOAR notifications (simulated)
# SOAR_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SOAR_WEBHOOK_URL=
